als in an integrated society.\\n**Environmental Magic**\\nTeaches magical methods for protecting, healing nature, and working with natural forces.\\n**Vampiric Studies**\\nInvestigates vampirism from biological, psychological, and historical perspectives.\\n**Lycanthropy Studies**\\nFocuses on understanding werewolves, their biology, and social structures.\\n</degrees>\\n</SUCC>\",\r\n    \"constant\": false,\r\n    \"selective\": true,\r\n    \"selectiveLogic\": 0,\r\n    \"addMemo\": true,\r\n    \"order\": 100,\r\n    \"position\": 0,\r\n    \"disable\": false,\r\n    \"excludeRecursion\": true,\r\n    \"probability\": 100,\r\n    \"useProbability\": true,\r\n    \"depth\": 4,\r\n    \"group\": \"\",\r\n    \"scanDepth\": null,\r\n    \"caseSensitive\": null,\r\n    \"matchWholeWords\": true,\r\n    \"automationId\": \"\",\r\n    \"role\": null,\r\n    \"displayIndex\": 33,\r\n    \"preventRecursion\": true,\r\n    \"groupOverride\": false,\r\n    \"groupWeight\": 100,\r\n    \"vectorized\": false,\r\n    \"delayUntilRecursion\": false,\r\n    \"useGroupScoring\": null,\r\n    \"sticky\": 0,\r\n    \"cooldown\": 0,\r\n    \"delay\": 0,\r\n    \"matchPersonaDescription\": false,\r\n    \"matchCharacterDescription\": false,\r\n    \"matchCharacterPersonality\": false,\r\n    \"matchCharacterDepthPrompt\": false,\r\n    \"matchScenario\": false,\r\n    \"matchCreatorNotes\": false,\r\n    \"ignoreBudget\": false,\r\n    \"outletName\": \"\",\r\n    \"triggers\": [],\r\n    \"characterFilter\": {\r\n      \"isExclude\": false,\r\n      \"names\": [],\r\n      \"tags\": []\r\n    },\r\n    \"activationMode\": \"standard\",\r\n    \"activationScript\": \"\",\r\n    \"case_sensitive\": false,\r\n    \"category\": \"other\",\r\n    \"enabled\": true,\r\n    \"extensions\": {},\r\n    \"id\": 1,\r\n    \"inclusionGroupRaw\": \"\",\r\n    \"insertion_order\": 200,\r\n    \"keyMatchPriority\": false,\r\n    \"keysecondaryRaw\": \"\",\r\n    \"keysRaw\": \"supernatural major