cturnal_crisis>\\n\",\r\n    \"constant\": false,\r\n    \"vectorized\": false,\r\n    \"selective\": true,\r\n    \"selectiveLogic\": 0,\r\n    \"addMemo\": true,\r\n    \"order\": 100,\r\n    \"position\": 0,\r\n    \"disable\": false,\r\n    \"excludeRecursion\": true,\r\n    \"preventRecursion\": true,\r\n    \"delayUntilRecursion\": false,\r\n    \"probability\": 100,\r\n    \"useProbability\": true,\r\n    \"depth\": 4,\r\n    \"group\": \"\",\r\n    \"groupOverride\": false,\r\n    \"groupWeight\": 100,\r\n    \"scanDepth\": null,\r\n    \"caseSensitive\": null,\r\n    \"matchWholeWords\": true,\r\n    \"useGroupScoring\": null,\r\n    \"automationId\": \"\",\r\n    \"role\": null,\r\n    \"sticky\": 0,\r\n    \"cooldown\": 0,\r\n    \"delay\": 0,\r\n    \"displayIndex\": 48,\r\n    \"matchPersonaDescription\": false,\r\n    \"matchCharacterDescription\": false,\r\n    \"matchCharacterPersonality\": false,\r\n    \"matchCharacterDepthPrompt\": false,\r\n    \"matchScenario\": false,\r\n    \"matchCreatorNotes\": false,\r\n    \"ignoreBudget\": false,\r\n    \"outletName\": \"\",\r\n    \"triggers\": [],\r\n    \"characterFilter\": {\r\n      \"isExclude\": false,\r\n      \"names\": [],\r\n      \"tags\": []\r\n    },\r\n    \"activationMode\": \"standard\",\r\n    \"activationScript\": \"\",\r\n    \"case_sensitive\": false,\r\n    \"category\": \"other\",\r\n    \"enabled\": true,\r\n    \"extensions\": {},\r\n    \"id\": 28,\r\n    \"inclusionGroupRaw\": \"\",\r\n    \"insertion_order\": 2900,\r\n    \"keyMatchPriority\": false,\r\n    \"keysecondaryRaw\": \"\",\r\n    \"keysRaw\": \"Nocturnal Crisis, 1999\",\r\n    \"minMessages\": 0,\r\n    \"name\": \"\",\r\n    \"prioritizeInclusion\": false,\r\n    \"priority\": 29,\r\n    \"tags\": [],\r\n    \"keywordsRaw\": \"Nocturnal Crisis, 1999\"\r\n  },\r\n  {\r\n    \"uid\": 29,\r\n    \"key\": [\r\n      \"Demihuman instructions\"\r\n    ],\r\n    \"keysecondary\": [],\r\n    \"comment\": \"🗺️ DEMIHUMAN INSTRUCTIONS [ can turn off ]\",\r\n    \"content\": \"• Pay close attention to the species of present demihuman characters and draw similarities between the behavior they exhibit and how it relates to their animalistic half.\\n• Frequently mention agents' bestial physical qualities. Tails, horns, wings, scales, antlers, eyes, ears, tongues, sharp nails, fangs/canines, and so on. Use said animal features to convey emotions. E.g., A dog demihuman's ears flattening when sad/threatened, a dog demihuman's tongue lolling out when being pet, a cat demihuman's tail whipping when angry, a reptile demihuman growing still when discovering potential pray, bird demihuman's feathers ruffling when upset.\\n• Refer to bestial traits in subtle ways, referencing them in unique ways. E.g., Demihuman's canines glinting when they grin/smirk.\\n• Play into each character's instinctual likes/dislikes and incorporate them into the roleplay naturally. E.g., Dog demihumans wanting to cover loved ones in their scent, rabbit demihumans needing regular attention, cat demihumans grooming themselves, bird demihumans enjoying baths, lizard demihumans being coldblooded, etc.\\n• Retain characters' personality traits and typical habits/behavior, while still allowing their animal-half to influence/explain said behaviors.\\n• It's important to note that demihumans DO NOT have fur/feathers on their bodies, nor do they have paws, muzzles or beaks. Aside from their animalistic features such as their ears/tails/wings, the great majority of their body is that of a human.\",\r\n    \"constant\": true,\r\n    \"vectorized\": false,\r\n    \"selective\": true,\r\n    \"selectiveLogic\": 0,\r\n    \"addMemo\": true,\r\n    \"order\": 100,\r\n    \"position\": 0,\r\n    \"disable\": false,\r\n    \"excludeRecursion\": false,\r\n    \"preventRecursion\": false,\r\n    \"delayUntilRecursion\": false,\r\n    \"probability\": 100,\r\n    \"useProbability\": true,\r\n    \"depth\": 4,\r\n    \"group\": \"\",\r\n    \"g